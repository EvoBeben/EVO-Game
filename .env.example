# ---------------------------------------------------------------------------
# Live data sources. Every one of these is optional — with none of them set the
# site still runs fully from the seeded sample dataset (`npm run seed`).
# Check /stores in the running app to see which adapters are live.
# ---------------------------------------------------------------------------

# Best Buy Products API — free key, register at https://developer.bestbuy.com/
# This is the primary live source: real prices, online availability, and
# in-store availability, under an official ToS-clean API.
BESTBUY_API_KEY=

# eBay Browse API — https://developer.ebay.com/
# Client-credentials OAuth. NOTE: production Browse access requires eBay
# approval; without it these credentials only work against the sandbox.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to "sandbox" to hit the eBay sandbox instead of production.
EBAY_ENV=production

# ---------------------------------------------------------------------------
# HTML adapters (Newegg, Micro Center, B&H, Amazon).
#
# OFF BY DEFAULT AND UNSUPPORTED. These read public product pages rather than
# an API. Several of these retailers' terms of service prohibit automated
# collection, and most sit behind bot protection that will block you. Enabling
# them is your call and your responsibility. When on, every request goes
# through a robots.txt check and a per-host rate limit.
# ---------------------------------------------------------------------------
ENABLE_HTML_SOURCES=false

# Per-host minimum delay between requests, milliseconds.
SOURCE_RATE_LIMIT_MS=3000

# Contact string appended to the User-Agent so retailers can reach you.
SOURCE_CONTACT=

# ---------------------------------------------------------------------------
# DRAM spot-price index (market backdrop on the dashboard).
# Public TrendForce-derived tracker. Falls back to the seeded series when
# unset or unreachable.
# ---------------------------------------------------------------------------
DRAM_INDEX_URL=

# ---------------------------------------------------------------------------
# Shared secret required by POST /api/refresh. Leave empty to disable the
# HTTP refresh endpoint entirely (the `npm run refresh` CLI still works).
# ---------------------------------------------------------------------------
REFRESH_TOKEN=

# Override the SQLite location. Defaults to ./data/prices.db
# DATABASE_PATH=
